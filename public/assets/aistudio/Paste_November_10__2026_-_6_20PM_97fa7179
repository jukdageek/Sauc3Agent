    /* ===================================================================
       REAL-TIME VISUALIZER, FFT SCOPE & PITCH/GAIN ANALYSIS
       =================================================================== */
    function initVisualizer() {
      const canvas = document.getElementById('scope-canvas');
      const ctx = canvas.getContext('2d');

      function resizeCanvas() {
        canvas.width = canvas.parentElement.clientWidth;
        canvas.height = canvas.parentElement.clientHeight;
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      const bufferLength = analyzer.frequencyBinCount;
      const timeData = new Uint8Array(bufferLength);
      const freqData = new Uint8Array(bufferLength);

      function draw() {
        requestAnimationFrame(draw);
        if (!audioCtx) return;

        analyzer.getByteTimeDomainData(timeData);
        analyzer.getByteFrequencyData(freqData);

        // Perform Gain Staging & Loudness Metrics
        calculateLoudness(timeData);

        // Perform Autocorrelation Pitch & Key Detection
        if (isPlaying) {
          detectPitch(timeData, audioCtx.sampleRate);
        }

        // Render Scope Canvas
        ctx.fillStyle = '#050608';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        if (visualizerMode === 'fft') {
          // Draw Spectrum Frequency Bars
          const barWidth = (canvas.width / 64);
          let x = 0;
          for (let i = 0; i < 64; i++) {
            const barHeight = (freqData[i * 4] / 255) * canvas.height;
            const grad = ctx.createLinearGradient(0, canvas.height, 0, 0);
            grad.addColorStop(0, '#e11d48');
            grad.addColorStop(0.6, '#00f2fe');
            grad.addColorStop(1, '#39ff14');

            ctx.fillStyle = grad;
            ctx.fillRect(x, canvas.height - barHeight, barWidth - 1, barHeight);
            x += barWidth;
          }
        } else {
          // Draw Waveform Oscilloscope
          ctx.lineWidth = 2;
          ctx.strokeStyle = '#00f2fe';
          ctx.beginPath();

          const sliceWidth = canvas.width / bufferLength;
          let x = 0;

          for (let i = 0; i < bufferLength; i++) {
            const v = timeData[i] / 128.0;
            const y = (v * canvas.height) / 2;

            if (i === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);

            x += sliceWidth;
          }
          ctx.lineTo(canvas.width, canvas.height / 2);
          ctx.stroke();
        }
      }

      draw();
    }

    function setVisualizerMode(mode) {
      visualizerMode = mode;
      document.getElementById('btn-mode-fft').className = mode === 'fft' ? 'px-2 py-0.5 rounded bg-brand-600 text-white' : 'px-2 py-0.5 rounded text-slate-400';
      document.getElementById('btn-mode-wave').className = mode === 'wave' ? 'px-2 py-0.5 rounded bg-brand-600 text-white' : 'px-2 py-0.5 rounded text-slate-400';
    }

    /* Peak, RMS, and Gain Staging Calculations */
    function calculateLoudness(timeData) {
      let sumSq = 0;
      let peak = 0;

      for (let i = 0; i < timeData.length; i++) {
        const sample = (timeData[i] - 128) / 128;
        const abs = Math.abs(sample);
        if (abs > peak) peak = abs;
        sumSq += sample * sample;
      }

      const rms = Math.sqrt(sumSq / timeData.length);
      const peakDb = peak > 0 ? 20 * Math.log10(peak) : -100;
      const rmsDb = rms > 0 ? 20 * Math.log10(rms) : -100;
      const lufsDb = rmsDb - 3.0; // Approximation for real-time display

      // Update UI Meters
      const peakStr = peakDb > -90 ? peakDb.toFixed(1) + " dB" : "-INF";
      const rmsStr = rmsDb > -90 ? rmsDb.toFixed(1) + " dB" : "-INF";
      const lufsStr = lufsDb > -90 ? lufsDb.toFixed(1) + " LUFS" : "-INF";

      document.getElementById('header-peak-meter').innerText = peakStr;
      document.getElementById('meter-peak-val').innerText = peakStr;
      document.getElementById('meter-rms-val').innerText = rmsStr;
      document.getElementById('meter-lufs-val').innerText = lufsStr;

      // Update Bars
      const peakPct = Math.min(100, Math.max(0, (peakDb + 60) * 1.66));
      const rmsPct = Math.min(100, Math.max(0, (rmsDb + 60) * 1.66));
      document.getElementById('bar-peak').style.width = peakPct + '%';
      document.getElementById('bar-rms').style.width = rmsPct + '%';

      // Gain Staging Assistant Warnings
      const statusTag = document.getElementById('gain-stage-status');
      const recTag = document.getElementById('gain-recommendation');
      
      if (peakDb > -1.0) {
        statusTag.className = "text-[10px] bg-red-500/20 text-red-400 border border-red-500/30 px-1.5 py-0.5 rounded font-mono";
        statusTag.innerText = "CLIPPING RISK";
        recTag.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-red-400"></i> Signal is clipping! Turn down Preamp or TRIM gain.`;
      } else if (peakDb < -30 && isPlaying) {
        statusTag.className = "text-[10px] bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 px-1.5 py-0.5 rounded font-mono";
        statusTag.innerText = "TOO LOW";
        recTag.innerHTML = `<i class="fa-solid fa-circle-info text-yellow-400"></i> Input signal is quiet. Increase Preamp gain for better SNR.`;
      } else {
        statusTag.className = "text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-1.5 py-0.5 rounded font-mono";
        statusTag.innerText = "OPTIMAL";
        recTag.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400"></i> Headroom is ideal (-18 to -6 dB). Ready for vocal recording.`;
      }

      // Update AI Context Values
      document.getElementById('ai-context-peak').innerText = peakStr;
    }

    /* Pitch Detection Engine (Autocorrelation) */
    function detectPitch(timeData, sampleRate) {
      let SIZE = timeData.length;
      let sumOfSquares = 0;
      for (let i = 0; i < SIZE; i++) {
        let val = (timeData[i] - 128) / 128;
        sumOfSquares += val * val;
      }
      let rms = Math.sqrt(sumOfSquares / SIZE);
      if (rms < 0.01) return; // Signal too low

      let r1 = 0, r2 = SIZE - 1, thres = 0.2;
      for (let i = 0; i < SIZE / 2; i++) {
        if (Math.abs((timeData[i] - 128) / 128) < thres) { r1 = i; break; }
      }
      for (let i = 1; i < SIZE / 2; i++) {
        if (Math.abs((timeData[SIZE - i] - 128) / 128) < thres) { r2 = SIZE - i; break; }
      }

      let buf = timeData.slice(r1, r2);
      SIZE = buf.length;

      let c = new Float32Array(SIZE);
      for (let i = 0; i < SIZE; i++) {
        for (let j = 0; j < SIZE - i; j++) {
          c[i] = c[i] + ((buf[j] - 128) / 128) * ((buf[j + i] - 128) / 128);
        }
      }

      let d = 0;
      while (c[d] > c[d + 1]) d++;
      let maxval = -1, maxpos = -1;
      for (let i = d; i < SIZE; i++) {
        if (c[i] > maxval) {
          maxval = c[i];
          maxpos = i;
        }
      }

      let T0 = maxpos;
      if (T0 === -1) return;

      let fundamentalFreq = sampleRate / T0;
      if (fundamentalFreq < 50 || fundamentalFreq > 1500) return; // Vocal human pitch boundaries

      // Calculate Note and Cents offset
      const noteNum = 12 * (Math.log(fundamentalFreq / 440) / Math.log(2)) + 69;
      const roundNote = Math.round(noteNum);
      const cents = Math.round((noteNum - roundNote) * 100);
      const noteName = NOTE_NAMES[roundNote % 12];

      audioMetrics.pitchHz = fundamentalFreq;
      audioMetrics.noteName = noteName;
      audioMetrics.cents = cents;

      // Update Pitch UI
      document.getElementById('detected-key').innerText = noteName;
      document.getElementById('detected-freq').innerText = fundamentalFreq.toFixed(1) + " Hz";
      document.getElementById('detected-cents').innerText = (cents >= 0 ? "+" : "") + cents + " Cents";
      document.getElementById('cents-indicator').style.left = Math.min(95, Math.max(5, 50 + cents / 2)) + '%';

      // Update AI context
      document.getElementById('ai-context-key').innerText = noteName + " Major";
    }

    /* ===================================================================
       CUSTOM KNOB CONTROLS & INTERACTION (TVB STYLED)
       =================================================================== */
    function setupKnobListeners() {
      const knobs = document.querySelectorAll('.knob-container');

      knobs.forEach(knob => {
        let isDragging = false;
        let startY = 0;
        let startValue = parseFloat(knob.dataset.value);

        const dial = knob.querySelector('.knob-dial');
        const indicator = knob.querySelector('.knob-indicator');
        const valText = knob.querySelector('.knob-val');

        function updateDisplay(val) {
          const min = parseFloat(knob.dataset.min);
          const max = parseFloat(knob.dataset.max);
          const pct = ((val - min) / (max - min)) * 100;
          const rotation = (pct * 2.7) - 135; // -135deg to +135deg rotation range

          dial.style.setProperty('--knob-pct', `${pct}%`);
          indicator.style.transform = `rotate(${rotation}deg)`;
          
          const unit = knob.dataset.unit || '';
          valText.innerText = (val > 0 && unit === 'dB' ? '+' : '') + val.toFixed(1).replace('.0', '') + (unit ? ' ' + unit : '');

          // Update DSP Node
          updateDspFromKnob(knob.dataset.knob, val);
        }

        // Initialize knob rotation
        updateDisplay(startValue);

        knob.addEventListener('pointerdown', e => {
          isDragging = true;
          startY = e.clientY;
          startValue = parseFloat(knob.dataset.value);
          knob.setPointerCapture(e.pointerId);
        });

        knob.addEventListener('pointermove', e => {
          if (!isDragging) return;
          const deltaY = startY - e.clientY;
          const min = parseFloat(knob.dataset.min);
          const max = parseFloat(knob.dataset.max);
          const step = (max - min) / 100;

          let newVal = startValue + deltaY * step;
          newVal = Math.min(max, Math.max(min, newVal));

          knob.dataset.value = newVal;
          updateDisplay(newVal);
        });

        knob.addEventListener('pointerup', e => {
          isDragging = false;
          knob.releasePointerCapture(e.pointerId);
        });
      });
    }

    /* Map Knob Changes directly to Web Audio DSP parameters */
    function updateDspFromKnob(name, val) {
      if (!audioCtx) return;

      switch(name) {
        case 'preamp-gain':
          if (dsp.preampGain) dsp.preampGain.gain.value = Math.pow(10, val / 20);
          break;
        case 'preamp-hpf':
          if (dsp.preampHpf) dsp.preampHpf.frequency.value = val;
          break;
        case 'comp-thresh':
          if (dsp.compThresh) dsp.compThresh.threshold.value = val;
          break;
        case 'comp-ratio':
          if (dsp.compThresh) dsp.compThresh.ratio.value = val;
          break;
        case 'comp-makeup':
          if (dsp.compMakeup) dsp.compMakeup.gain.value = Math.pow(10, val / 20);
          break;
        case 'eq-low':
          if (dsp.eqLow) dsp.eqLow.gain.value = val;
          break;
        case 'eq-mid':
          if (dsp.eqMid) dsp.eqMid.gain.value = val;
          break;
        case 'eq-high':
          if (dsp.eqHigh) dsp.eqHigh.gain.value = val;
          break;
        case 'eq-air':
          if (dsp.eqAir) dsp.eqAir.gain.value = val;
          break;
        case 'space-delay-fb':
          if (dsp.spaceDelayFb) dsp.spaceDelayFb.gain.value = val / 100;
          break;
        case 'space-delay-mix':
          if (dsp.spaceDelayMix) dsp.spaceDelayMix.gain.value = val / 100;
          break;
      }
    }

    /* Bypass Toggles */
    function toggleBypass(moduleName) {
      dsp.bypassed[moduleName] = !dsp.bypassed[moduleName];
      const btn = document.getElementById(`bypass-${moduleName}`);
      if (dsp.bypassed[moduleName]) {
        btn.className = "w-4 h-4 rounded-full bg-slate-600 transition cursor-pointer";
      } else {
        btn.className = "w-4 h-4 rounded-full bg-emerald-500 glow-led-green transition cursor-pointer";
      }
    }

    /* Reset All Modules */
    function resetRack() {
      loadPreset('bypass');
    }

    /* Load Presets */
    function loadPreset(preset) {
      const knobValues = {
        'modern-vocal': { 'preamp-gain': 6, 'preamp-drive': 30, 'preamp-hpf': 100, 'comp-thresh': -20, 'comp-ratio': 4, 'eq-low': -4, 'eq-mid': 2, 'eq-high': 5, 'eq-air': 4, 'space-delay-fb': 30, 'space-delay-mix': 15 },
        'crisp-pop': { 'preamp-gain': 4, 'preamp-drive': 15, 'preamp-hpf': 120, 'comp-thresh': -16, 'comp-ratio': 3, 'eq-low': -5, 'eq-mid': 3, 'eq-high': 6, 'eq-air': 6, 'space-delay-fb': 20, 'space-delay-mix': 20 },
        'warm-tube': { 'preamp-gain': 8, 'preamp-drive': 65, 'preamp-hpf': 75, 'comp-thresh': -14, 'comp-ratio': 2, 'eq-low': 1, 'eq-mid': 1, 'eq-high': 2, 'eq-air': 1, 'space-delay-fb': 15, 'space-delay-mix': 10 },
        'heavy-autotune': { 'preamp-gain': 6, 'preamp-drive': 40, 'preamp-hpf': 110, 'comp-thresh': -24, 'comp-ratio': 8, 'eq-low': -6, 'eq-mid': 4, 'eq-high': 4, 'eq-air': 3, 'space-delay-fb': 45, 'space-delay-mix': 25 },
        'clean-podcast': { 'preamp-gain': 2, 'preamp-drive': 0, 'preamp-hpf': 90, 'comp-thresh': -12, 'comp-ratio': 2.5, 'eq-low': -2, 'eq-mid': 1, 'eq-high': 1, 'eq-air': 0, 'space-delay-fb': 0, 'space-delay-mix': 0 },
        'bypass': { 'preamp-gain': 0, 'preamp-drive': 0, 'preamp-hpf': 20, 'comp-thresh': 0, 'comp-ratio': 1, 'eq-low': 0, 'eq-mid': 0, 'eq-high': 0, 'eq-air': 0, 'space-delay-fb': 0, 'space-delay-mix': 0 }
      };

      const set = knobValues[preset] || knobValues['bypass'];
      for (const [knobName, value] of Object.entries(set)) {
        const container = document.querySelector(`[data-knob="${knobName}"]`);
        if (container) {
          container.dataset.value = value;
          const min = parseFloat(container.dataset.min);
          const max = parseFloat(container.dataset.max);
          const pct = ((value - min) / (max - min)) * 100;
          const rotation = (pct * 2.7) - 135;

          const dial = container.querySelector('.knob-dial');
          const indicator = container.querySelector('.knob-indicator');
          const valText = container.querySelector('.knob-val');

          dial.style.setProperty('--knob-pct', `${pct}%`);
          indicator.style.transform = `rotate(${rotation}deg)`;
          
          const unit = container.dataset.unit || '';
          valText.innerText = (value > 0 && unit === 'dB' ? '+' : '') + value + (unit ? ' ' + unit : '');

          updateDspFromKnob(knobName, value);
        }
      }
    }

