
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SAUC3 AGENT - Digital Audio Rack & Studio Assistant</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#fff1f2',
              100: '#ffe4e6',
              500: '#f43f5e',
              600: '#e11d48',
              900: '#881337',
              accent: '#00f2fe',
              neon: '#39ff14'
            },
            rack: {
              bg: '#0c0d10',
              panel: '#15171e',
              panelDark: '#101116',
              border: '#262933',
              knobBorder: '#3b3f51',
              screen: '#050608'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Skeuomorphic & Cyber Studio Rack Styling */
    body {
      background-color: #08090b;
      color: #e2e8f0;
      user-select: none;
    }

    /* Metal Screws for TVB Rack Look */
    .rack-screw {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #64748b, #1e293b);
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.4), 0 2px 4px rgba(0,0,0,0.8);
      position: relative;
    }
    .rack-screw::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 8px;
      height: 2px;
      background: #0f172a;
      transform: translate(-50%, -50%) rotate(45deg);
    }

    /* Custom Knobs */
    .knob-container {
      position: relative;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      touch-action: none;
    }

    .knob-dial {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: conic-gradient(from 225deg, #00f2fe 0%, #f43f5e var(--knob-pct, 0%), #1e293b var(--knob-pct, 0%), #1e293b 100%);
      padding: 3px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.6), inset 0 1px 2px rgba(255,255,255,0.2);
      cursor: ns-resize;
      transition: box-shadow 0.2s ease;
    }

    .knob-dial:hover {
      box-shadow: 0 0 12px rgba(244, 63, 94, 0.4), 0 4px 10px rgba(0,0,0,0.8);
    }

    .knob-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #2a2e3d, #12141a);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .knob-indicator {
      position: absolute;
      width: 3px;
      height: 18px;
      background: #ffffff;
      top: 4px;
      border-radius: 2px;
      box-shadow: 0 0 6px #ffffff;
      transform-origin: bottom center;
    }

    /* Glowing Meters */
    .glow-led-red { box-shadow: 0 0 8px #ef4444; }
    .glow-led-green { box-shadow: 0 0 8px #10b981; }
    .glow-led-blue { box-shadow: 0 0 8px #00f2fe; }

    /* Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0c0d10;
    }
    ::-webkit-scrollbar-thumb {
      background: #262933;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3f4455;
    }

    /* Visualizer Canvas */
    canvas {
      display: block;
    }
  </style>
</head>
<body class="h-screen flex flex-col overflow-hidden font-sans">

  <!-- TOP HEADER / STUDIO NAVIGATION BAR -->
  <header class="h-14 bg-rack-panelDark border-b border-rack-border flex items-center justify-between px-4 z-20">
    <div class="flex items-center space-x-3">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-600 to-brand-accent flex items-center justify-center font-black text-white text-lg tracking-wider shadow-lg">
          S3
        </div>
        <div>
          <h1 class="text-sm font-bold tracking-wider text-slate-100 flex items-center gap-2">
            SAUC3 AGENT <span class="text-[10px] bg-brand-600/30 text-brand-accent border border-brand-accent/30 px-1.5 py-0.5 rounded font-mono">v2.5 RACK</span>
          </h1>
          <p class="text-[10px] text-slate-400 font-mono">NEXT-GEN AUDIO ENGINE & STUDIO ASSISTANT</p>
        </div>
      </div>
    </div>

    <!-- MAIN AUDIO CONTROLS / INPUT SELECTOR -->
    <div class="flex items-center space-x-3">
      <!-- Input Source Switcher -->
      <div class="flex bg-rack-screen rounded-lg border border-rack-border p-1 space-x-1">
        <button id="btn-input-mic" onclick="switchAudioSource('mic')" class="px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 transition text-slate-400 hover:text-slate-200">
          <i class="fa-solid font-bold fa-microphone"></i> Live Mic
        </button>
        <button id="btn-input-file" onclick="switchAudioSource('file')" class="px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 bg-brand-600 text-white shadow">
          <i class="fa-solid fa-file-audio"></i> Audio File
        </button>
        <button id="btn-input-synth" onclick="switchAudioSource('demo')" class="px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 text-slate-400 hover:text-slate-200">
          <i class="fa-solid fa-wave-square"></i> Demo Tone
        </button>
      </div>

      <!-- File Load Input (Hidden) -->
      <input type="file" id="audio-file-input" accept="audio/*" class="hidden" onchange="handleFileUpload(event)">
      <button onclick="document.getElementById('audio-file-input').click()" class="bg-rack-panel border border-rack-border hover:border-slate-500 text-slate-300 text-xs px-3 py-1.5 rounded-lg flex items-center gap-2 transition">
        <i class="fa-solid fa-upload text-brand-accent"></i> Import Track
      </button>

      <!-- Playback Transport Controls -->
      <div class="flex items-center space-x-1 bg-rack-screen px-2 py-1 rounded-lg border border-rack-border">
        <button id="btn-play" onclick="togglePlayback()" class="w-8 h-8 rounded flex items-center justify-center text-slate-300 hover:text-white hover:bg-white/10 transition">
          <i class="fa-solid fa-play text-xs" id="play-icon"></i>
        </button>
        <button onclick="stopPlayback()" class="w-8 h-8 rounded flex items-center justify-center text-slate-300 hover:text-white hover:bg-white/10 transition">
          <i class="fa-solid fa-stop text-xs"></i>
        </button>
        <button id="btn-loop" onclick="toggleLoop()" class="w-8 h-8 rounded flex items-center justify-center text-slate-400 hover:text-white transition" title="Toggle Loop">
          <i class="fa-solid fa-repeat text-xs"></i>
        </button>
      </div>
    </div>

    <!-- RIGHT HEADER: MASTER METERS & AI TOGGLE -->
    <div class="flex items-center space-x-4">
      <!-- Master Level Quick Indicator -->
      <div class="flex items-center space-x-2 bg-rack-screen px-3 py-1 rounded-lg border border-rack-border font-mono text-xs">
        <span class="text-slate-400 text-[10px]">PEAK</span>
        <span id="header-peak-meter" class="text-emerald-400 font-bold w-12 text-right">-INF dB</span>
      </div>

      <button onclick="toggleAiDrawer()" class="bg-gradient-to-r from-brand-600 to-purple-600 text-white text-xs px-3 py-1.5 rounded-lg font-semibold flex items-center gap-2 shadow-lg hover:brightness-110 transition">
        <i class="fa-solid fa-wand-magic-sparkles"></i> AI Vocal Agent
      </button>
    </div>
  </header>

  <!-- MAIN STUDIO WORKSPACE -->
  <div class="flex-1 flex overflow-hidden relative">

    <!-- LEFT PANEL: REAL-TIME KEY DETECTOR, GAIN STAGING & MUZE/PLAYHEAD METRICS -->
    <aside class="w-80 bg-rack-panelDark border-r border-rack-border flex flex-col p-3 space-y-3 overflow-y-auto z-10">
      
      <!-- MUZE & PLAYHEAD ANALYZER HEADER -->
      <div class="flex items-center justify-between border-b border-rack-border pb-2">
        <span class="text-xs font-bold tracking-wider text-slate-300 uppercase flex items-center gap-2">
          <i class="fa-solid fa-chart-simple text-brand-accent"></i> Real-time Analyzer
        </span>
        <span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded border border-emerald-500/30 font-mono">LIVE 60FPS</span>
      </div>

      <!-- KEY & SCALE DETECTOR (PLAYHEAD STYLE) -->
      <div class="bg-rack-panel border border-rack-border rounded-xl p-3 relative overflow-hidden shadow-inner">
        <div class="absolute -right-4 -top-4 w-20 h-20 bg-brand-accent/5 rounded-full blur-xl"></div>
        <div class="flex justify-between items-center mb-1">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Musical Key & Scale</span>
          <span class="text-[10px] text-slate-500 font-mono" id="key-confidence">CONF: --%</span>
        </div>

        <div class="flex items-baseline justify-between py-2">
          <div class="text-3xl font-extrabold font-mono tracking-tight text-white flex items-baseline gap-2">
            <span id="detected-key" class="text-brand-accent">C</span>
            <span id="detected-scale" class="text-lg text-slate-300 font-normal">Major</span>
          </div>
          <div class="text-right">
            <div id="detected-freq" class="text-xs font-mono text-slate-400">440.0 Hz</div>
            <div id="detected-cents" class="text-[10px] font-mono text-emerald-400">+0 Cents</div>
          </div>
        </div>

        <!-- Pitch Tuning Bar -->
        <div class="w-full bg-rack-screen h-2 rounded-full overflow-hidden relative border border-rack-border mt-1">
          <div class="absolute top-0 bottom-0 w-0.5 bg-slate-500 left-1/2 -translate-x-1/2"></div>
          <div id="cents-indicator" class="h-full bg-brand-accent w-2 rounded-full relative transition-all duration-75" style="left: 50%;"></div>
        </div>

        <!-- Chroma Distribution Profile -->
        <div class="mt-3 grid grid-cols-12 gap-0.5 h-8 items-end bg-rack-screen p-1 rounded border border-rack-border">
          <div class="chroma-bar bg-brand-600/60 rounded-t h-1/4" title="C"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-1/3" title="C#"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-1/2" title="D"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-1/5" title="D#"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-3/4" title="E"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-2/3" title="F"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-1/3" title="F#"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-4/5" title="G"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-1/4" title="G#"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-2/4" title="A"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-1/3" title="A#"></div>
          <div class="chroma-bar bg-brand-600/60 rounded-t h-3/5" title="B"></div>
        </div>
        <div class="flex justify-between text-[8px] font-mono text-slate-500 mt-1 px-0.5">
          <span>C</span><span>D</span><span>E</span><span>F</span><span>G</span><span>A</span><span>B</span>
        </div>
      </div>

      <!-- GAIN STAGING & LOUDNESS ENGINE (MUZE STYLE) -->
      <div class="bg-rack-panel border border-rack-border rounded-xl p-3 space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Gain Staging Assistant</span>
          <span id="gain-stage-status" class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-1.5 py-0.5 rounded font-mono">OPTIMAL</span>
        </div>

        <div class="grid grid-cols-3 gap-2 text-center">
          <div class="bg-rack-screen p-2 rounded-lg border border-rack-border">
            <div class="text-[9px] text-slate-500 font-mono">PEAK</div>
            <div id="meter-peak-val" class="text-sm font-bold font-mono text-slate-200">-INF</div>
          </div>
          <div class="bg-rack-screen p-2 rounded-lg border border-rack-border">
            <div class="text-[9px] text-slate-500 font-mono">RMS</div>
            <div id="meter-rms-val" class="text-sm font-bold font-mono text-slate-200">-INF</div>
          </div>
          <div class="bg-rack-screen p-2 rounded-lg border border-rack-border">
            <div class="text-[9px] text-slate-500 font-mono">LUFS</div>
            <div id="meter-lufs-val" class="text-sm font-bold font-mono text-slate-200">-INF</div>
          </div>
        </div>

        <!-- Level VU Bars -->
        <div class="space-y-1.5 pt-1">
          <div>
            <div class="flex justify-between text-[10px] text-slate-400 font-mono mb-0.5">
              <span>PEAK LEVEL</span>
              <span id="peak-db-label">-18 dB Target</span>
            </div>
            <div class="h-2 bg-rack-screen rounded-full overflow-hidden border border-rack-border p-0.5">
              <div id="bar-peak" class="h-full bg-gradient-to-r from-emerald-500 via-yellow-400 to-red-500 rounded-full w-0 transition-all duration-75"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-[10px] text-slate-400 font-mono mb-0.5">
              <span>RMS POWER</span>
              <span>DYNAMIC RANGE</span>
            </div>
            <div class="h-2 bg-rack-screen rounded-full overflow-hidden border border-rack-border p-0.5">
              <div id="bar-rms" class="h-full bg-brand-accent rounded-full w-0 transition-all duration-75"></div>
            </div>
          </div>
        </div>

        <!-- Gain Recommendation Alert -->
        <div id="gain-recommendation" class="bg-rack-screen/60 border border-rack-border rounded-lg p-2 text-[11px] text-slate-300 flex items-start gap-2">
          <i class="fa-solid fa-circle-info text-brand-accent mt-0.5"></i>
          <span>Target vocal headroom is -18 dBFS to -12 dBFS peak. Adjust Preamp gain for clean saturation.</span>
        </div>
      </div>

      <!-- SPECTRUM VISUALIZER & OSCILLOSCOPE TOGGLE -->
      <div class="bg-rack-panel border border-rack-border rounded-xl p-3 flex-1 flex flex-col">
        <div class="flex justify-between items-center mb-2">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Live Scope & FFT</span>
          <div class="flex bg-rack-screen rounded border border-rack-border p-0.5 text-[10px] font-mono">
            <button id="btn-mode-fft" onclick="setVisualizerMode('fft')" class="px-2 py-0.5 rounded bg-brand-600 text-white">FFT</button>
            <button id="btn-mode-wave" onclick="setVisualizerMode('wave')" class="px-2 py-0.5 rounded text-slate-400">WAVE</button>
          </div>
        </div>
        <div class="flex-1 bg-rack-screen border border-rack-border rounded-lg overflow-hidden relative min-h-[120px]">
          <canvas id="scope-canvas" class="w-full h-full"></canvas>
        </div>
      </div>

    </aside>

    <!-- CENTER RACK CONTAINER (TVB RACK STYLE) -->
    <main class="flex-1 bg-rack-bg overflow-y-auto p-4 space-y-4">

      <!-- RACK TOP TOOLBAR -->
      <div class="flex items-center justify-between bg-rack-panel p-3 rounded-xl border border-rack-border shadow-md">
        <div class="flex items-center space-x-3">
          <div class="rack-screw"></div>
          <span class="text-xs font-bold uppercase tracking-widest text-slate-300 font-mono">
            TVB-STYLE VOCAL RACK CHASSIS
          </span>
          <span class="text-[10px] bg-brand-600/20 text-brand-500 border border-brand-600/30 px-2 py-0.5 rounded font-mono">
            7 MODULES ACTIVE
          </span>
        </div>

        <!-- Preset Manager -->
        <div class="flex items-center space-x-2">
          <label class="text-xs text-slate-400 font-mono">PRESET:</label>
          <select id="preset-selector" onchange="loadPreset(this.value)" class="bg-rack-screen border border-rack-border text-slate-200 text-xs rounded-lg px-3 py-1.5 font-mono focus:outline-none focus:border-brand-accent">
            <option value="modern-vocal">Modern Trap Lead Vocal</option>
            <option value="crisp-pop">Crisp Bright Pop Vocal</option>
            <option value="warm-tube">Warm Vintage Tube Analog</option>
            <option value="heavy-autotune">Hard Tune Hyperpop Agent</option>
            <option value="clean-podcast">Podcast / Voiceover Clean</option>
            <option value="bypass">All Modules Flat / Bypass</option>
          </select>
          <button onclick="resetRack()" class="bg-rack-panel border border-rack-border hover:bg-slate-800 text-slate-300 text-xs px-3 py-1.5 rounded-lg transition" title="Reset All Modules">
            <i class="fa-solid fa-rotate-left"></i>
          </button>
        </div>
      </div>

      <!-- MODULE 1: PREAMP / TUBE SATURATOR -->
      <section class="bg-rack-panel border border-rack-border rounded-xl p-4 shadow-xl relative overflow-hidden">
        <div class="absolute left-2 top-2 rack-screw"></div>
        <div class="absolute right-2 top-2 rack-screw"></div>
        <div class="absolute left-2 bottom-2 rack-screw"></div>
        <div class="absolute right-2 bottom-2 rack-screw"></div>

        <div class="flex items-center justify-between pb-3 border-b border-rack-border mb-4 px-4">
          <div class="flex items-center space-x-3">
            <button onclick="toggleBypass('preamp')" id="bypass-preamp" class="w-4 h-4 rounded-full bg-emerald-500 glow-led-green transition cursor-pointer" title="Toggle Bypass"></button>
            <h2 class="text-sm font-extrabold tracking-wider text-slate-200 uppercase font-mono">01. CONSOLE PREAMP & TUBE SATURATION</h2>
          </div>
          <span class="text-[10px] text-amber-400 font-mono bg-amber-400/10 border border-amber-400/20 px-2 py-0.5 rounded">ANALOG WARMTH</span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 px-4">
          <!-- Input Gain Knob -->
          <div class="knob-container" data-knob="preamp-gain" data-min="-24" data-max="24" data-value="6" data-unit="dB">
            <div class="knob-dial"><div class="knob-inner"><div class="knob-indicator"></div></div></div>
            <span class="text-[10px] font-mono text-slate-400 mt-2">PREAMP GAIN</span>
            <span class="knob-val text-xs font-mono font-bold text-brand-accent">+6.0 dB</span>
          </div>

          <!-- Saturation Knob -->
          <div class="knob-container" data-knob="preamp-drive" data-min="0" data-max="100" data-value="25" data-unit="%">
            <div class="knob-dial"><div class="knob-inner"><div class="knob-indicator"></div></div></div>
            <span class="text-[10px] font-mono text-slate-400 mt-2">TUBE DRIVE</span>
            <span class="knob-val text-xs font-mono font-bold text-brand-accent">25%</span>
          </div>

          <!-- High Pass Filter Knob -->
          <div class="knob-container" data-knob="preamp-hpf" data-min="20" data-max="300" data-value="80" data-unit="Hz">
            <div class="knob-dial"><div class="knob-inner"><div class="knob-indicator"></div></div></div>
            <span class="text-[10px] font-mono text-slate-400 mt-2">LOW CUT (HPF)</span>
            <span class="knob-val text-xs font-mono font-bold text-brand-accent">80 Hz</span>
          </div>

          <!-- Output Trim Knob -->
          <div class="knob-container" data-knob="preamp-out" data-min="-24" data-max="12" data-value="0" data-unit="dB">
            <div class="knob-dial"><div class="knob-inner"><div class="knob-indicator"></div></div></div>
            <span class="text-[10px] font-mono text-slate-400 mt-2">TRIM OUT</span>
            <span class="knob-val text-xs font-mono font-bold text-brand-accent">0.0 dB</span>
          </div>
        </div>
      </section>

      <!-- MODULE 2: TUBE OPTICAL COMPRESSOR -->
      <section class="bg-rack-panel border border-rack-border rounded-xl p-4 shadow-xl relative">
        <div class="absolute left-2 top-2 rack-screw"></div>
        <div class="absolute right-2 top-2 rack-screw"></div>
        <div class="absolute left-2 bottom-2 rack-screw"></div>
        <div class="absolute right-2 bottom-2 rack-screw"></div>

        <div class="flex items-center justify-between pb-3 border-b border-rack-border mb-4 px-4">
          <div class="flex items-center space-x-3">
            <button onclick="toggleBypass('comp')" id="bypass-comp" class="w-4 h-4 rounded-full bg-emerald-500 glow-led-green transition cursor-pointer"></button>
            <h2 class="text-sm font-extrabold tracking-wider text-slate-200 uppercase font-mono">02. OPTICAL TUBE COMPRESSOR (OPTO 2A)</h2>
          </div>
          <!-- Gain Reduction Meter -->
          <div class="flex items-center space-x-2 bg-rack-screen border border-rack-border px-3 py-1 rounded font-mono text-xs">
            <span class="text-slate-500 text-[10px]">GR:</span>
            <span id="gr-meter-text" class="text-red-400 font-bold">-0.0 dB</span>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 px-4">
          <!-- Threshold -->
          <div class="knob-container" data-knob="comp-thresh" data-min="-60" data-max="0" data-value="-18" data-unit="dB">
            <div class="knob-dial"><div class="knob-inner"><div class="knob-indicator"></div></div></div>
            <span class="text-[10px] font-mono text-slate-400 mt-2">THRESHOLD</span>
            <span class="knob-val text-xs font-mono font-bold text-brand-accent">-18 dB</span>
          </div>

          <!-- Ratio -->
          <div class="knob-container" data-knob="comp-ratio" data-min="1" data-max="20" data-value="4" data-unit=":1">
            <div class="knob-dial"><div class="knob-inner"><div class="knob-indicator"></div></div></div>
            <span class="text-[10px] font-mono text-slate-400 mt-2">RATIO</span>
            <span class="knob-val text-xs font-mono font-bold text-brand-accent">4:1</span>
          </div>

          <!-- Attack/Release Speed -->
          <div class="knob-container" data-knob="comp-attack" data-min="1" data-max="100" data-value="20" data-unit="ms">
