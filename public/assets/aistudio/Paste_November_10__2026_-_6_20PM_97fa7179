  <!-- JAVASCRIPT AUDIO ENGINE & INTERACTION LOGIC -->
  <script>
    /* ===================================================================
       GLOBAL AUDIO ENGINE & STATE VARIABLES
       =================================================================== */
    let audioCtx = null;
    let masterGain = null;
    let analyzer = null;
    let sourceNode = null;
    let audioBuffer = null;
    let isPlaying = false;
    let isLooping = false;
    let currentInputSource = 'file'; // 'mic', 'file', 'demo'
    let visualizerMode = 'fft'; // 'fft' or 'wave'

    // DSP Nodes Container
    const dsp = {
      preampGain: null,
      preampDrive: null,
      preampHpf: null,
      preampOut: null,

      compThresh: null,
      compRatio: null,
      compAttack: null,
      compMakeup: null,

      eqLow: null,
      eqMid: null,
      eqHigh: null,
      eqAir: null,

      pitchShift: null, // Simulated DSP

      spaceDelay: null,
      spaceDelayFb: null,
      spaceDelayMix: null,
      spaceVerbMix: null,

      masterCeiling: null,
      masterGain: null,

      bypassed: {
        preamp: false,
        comp: false,
        eq: false,
        pitch: false,
        space: false,
        master: false
      }
    };

    // Detected Audio Metrics State
    const audioMetrics = {
      pitchHz: 440,
      noteName: 'C',
      scaleName: 'Major',
      cents: 0,
      confidence: 0,
      peakDb: -100,
      rmsDb: -100,
      lufsDb: -100
    };

    const NOTE_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];

    /* ===================================================================
       INITIALIZATION & AUDIO CONTEXT CREATION
       =================================================================== */
    function initAudio() {
      if (audioCtx) return;
      
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      audioCtx = new AudioContext();

      // Master Output Analyzer Node
      analyzer = audioCtx.createAnalyser();
      analyzer.fftSize = 2048;

      // Master Volume Node
      masterGain = audioCtx.createGain();
      masterGain.gain.value = 1.0;

      // Build Audio DSP Processing Graph
      buildDspGraph();

      // Initialize Canvas Visualizer Loop
      initVisualizer();

      // Render Knob Dial Positions
      setupKnobListeners();

      // Load Default Demo Tone Sound / Buffer
      generateDemoToneBuffer();
    }

    /* Build Web Audio DSP Signal Path */
    function buildDspGraph() {
      // 01. Preamp Nodes
      dsp.preampGain = audioCtx.createGain();
      dsp.preampHpf = audioCtx.createBiquadFilter();
      dsp.preampHpf.type = 'highpass';
      dsp.preampHpf.frequency.value = 80;

      dsp.preampOut = audioCtx.createGain();

      // 02. Compressor Node
      dsp.compThresh = audioCtx.createDynamicsCompressor();
      dsp.compThresh.threshold.value = -18;
      dsp.compThresh.knee.value = 12;
      dsp.compThresh.ratio.value = 4;
      dsp.compThresh.attack.value = 0.02;
      dsp.compThresh.release.value = 0.25;

      dsp.compMakeup = audioCtx.createGain();
      dsp.compMakeup.gain.value = 1.4; // +3dB

      // 03. 4-Band EQ Nodes
      dsp.eqLow = audioCtx.createBiquadFilter();
      dsp.eqLow.type = 'peaking';
      dsp.eqLow.frequency.value = 250;

      dsp.eqMid = audioCtx.createBiquadFilter();
      dsp.eqMid.type = 'peaking';
      dsp.eqMid.frequency.value = 1500;

      dsp.eqHigh = audioCtx.createBiquadFilter();
      dsp.eqHigh.type = 'peaking';
      dsp.eqHigh.frequency.value = 5000;

      dsp.eqAir = audioCtx.createBiquadFilter();
      dsp.eqAir.type = 'highshelf';
      dsp.eqAir.frequency.value = 12000;

      // 04. Space Reverb / Delay Nodes
      dsp.spaceDelay = audioCtx.createDelay();
      dsp.spaceDelay.delayTime.value = 0.3; // 300ms
      dsp.spaceDelayFb = audioCtx.createGain();
      dsp.spaceDelayFb.gain.value = 0.3;
      dsp.spaceDelayMix = audioCtx.createGain();
      dsp.spaceDelayMix.gain.value = 0.15;

      // Connect Delay Feedback Loop
      dsp.spaceDelay.connect(dsp.spaceDelayFb);
      dsp.spaceDelayFb.connect(dsp.spaceDelay);

      // 05. Master Limiter / Output
      dsp.masterGain = audioCtx.createGain();

      // Signal Chain Routing:
      // Preamp -> Comp -> EQ -> Space -> Master -> Analyzer -> Destination
      dsp.preampGain.connect(dsp.preampHpf);
      dsp.preampHpf.connect(dsp.preampOut);

      dsp.preampOut.connect(dsp.compThresh);
      dsp.compThresh.connect(dsp.compMakeup);

      dsp.compMakeup.connect(dsp.eqLow);
      dsp.eqLow.connect(dsp.eqMid);
      dsp.eqMid.connect(dsp.eqHigh);
      dsp.eqHigh.connect(dsp.eqAir);

      // Split to Delay Path
      dsp.eqAir.connect(dsp.masterGain);
      dsp.eqAir.connect(dsp.spaceDelay);
      dsp.spaceDelay.connect(dsp.spaceDelayMix);
      dsp.spaceDelayMix.connect(dsp.masterGain);

      dsp.masterGain.connect(analyzer);
      analyzer.connect(audioCtx.destination);
    }

    /* ===================================================================
       AUDIO SOURCE HANDLERS (MIC / FILE / SYNTH TONE)
       =================================================================== */
    async function switchAudioSource(type) {
      initAudio();
      currentInputSource = type;

      // UI Switch Styling
      document.getElementById('btn-input-mic').className = type === 'mic' ? 'px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 bg-brand-600 text-white shadow' : 'px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 text-slate-400 hover:text-slate-200';
      document.getElementById('btn-input-file').className = type === 'file' ? 'px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 bg-brand-600 text-white shadow' : 'px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 text-slate-400 hover:text-slate-200';
      document.getElementById('btn-input-synth').className = type === 'demo' ? 'px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 bg-brand-600 text-white shadow' : 'px-3 py-1 rounded text-xs font-semibold flex items-center gap-1.5 text-slate-400 hover:text-slate-200';

      if (sourceNode) {
        try { sourceNode.stop(); } catch(e){}
        sourceNode.disconnect();
      }

      if (type === 'mic') {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
          sourceNode = audioCtx.createMediaStreamSource(stream);
          sourceNode.connect(dsp.preampGain);
          isPlaying = true;
          updatePlayIcon();
        } catch (err) {
          alert("Microphone access denied or unavailable: " + err.message);
        }
      } else if (type === 'demo') {
        generateDemoToneBuffer();
        startBufferSource();
      } else if (type === 'file' && audioBuffer) {
        startBufferSource();
      }
    }

    function handleFileUpload(e) {
      initAudio();
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        audioCtx.decodeAudioData(evt.target.result, function(buffer) {
          audioBuffer = buffer;
          switchAudioSource('file');
        }, function(err) {
          alert("Error decoding audio file: " + err.message);
        });
      };
      reader.readAsArrayBuffer(file);
    }

    function generateDemoToneBuffer() {
      if (!audioCtx) return;
      // Synthesize a pleasant vocal-like chord/tone for demo key detection
      const sampleRate = audioCtx.sampleRate;
      const duration = 4.0;
      const numSamples = sampleRate * duration;
      const buffer = audioCtx.createBuffer(2, numSamples, sampleRate);
      const left = buffer.getChannelData(0);
      const right = buffer.getChannelData(1);

      const rootFreq = 261.63; // C4
      for (let i = 0; i < numSamples; i++) {
        const t = i / sampleRate;
        const env = Math.sin(Math.PI * (t / duration));
        // C Major Triad Synth Blend
        const v1 = Math.sin(2 * Math.PI * rootFreq * t);
        const v2 = 0.5 * Math.sin(2 * Math.PI * (rootFreq * 1.25) * t); // E4
        const v3 = 0.4 * Math.sin(2 * Math.PI * (rootFreq * 1.5) * t);  // G4
        left[i] = (v1 + v2 + v3) * 0.2 * env;
        right[i] = left[i];
      }
      audioBuffer = buffer;
    }

    function startBufferSource() {
      if (!audioBuffer || !audioCtx) return;
      if (sourceNode) {
        try { sourceNode.stop(); } catch(e){}
      }
      sourceNode = audioCtx.createBufferSource();
      sourceNode.buffer = audioBuffer;
      sourceNode.loop = isLooping;
      sourceNode.connect(dsp.preampGain);
      sourceNode.start(0);
      isPlaying = true;
      updatePlayIcon();

      sourceNode.onended = () => {
        if (!isLooping && currentInputSource !== 'mic') {
          isPlaying = false;
          updatePlayIcon();
        }
      };
    }

    function togglePlayback() {
      initAudio();
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      if (isPlaying) {
        if (sourceNode && currentInputSource !== 'mic') {
          try { sourceNode.stop(); } catch(e){}
        }
        isPlaying = false;
      } else {
        if (currentInputSource === 'mic') {
          switchAudioSource('mic');
        } else {
          startBufferSource();
        }
      }
      updatePlayIcon();
    }

    function stopPlayback() {
      if (sourceNode && currentInputSource !== 'mic') {
        try { sourceNode.stop(); } catch(e){}
      }
      isPlaying = false;
      updatePlayIcon();
    }

    function toggleLoop() {
      isLooping = !isLooping;
