      btn.className = isLooping ? 'w-8 h-8 rounded flex items-center justify-center text-brand-accent bg-brand-accent/10 border border-brand-accent/30 transition' : 'w-8 h-8 rounded flex items-center justify-center text-slate-400 hover:text-white transition';
